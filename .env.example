# ── PocketBase superuser ───────────────────────────────────────────────
# Created on first boot (password generated + saved to .env if missing).
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=changeme123

# ── PocketBase test user ───────────────────────────────────────────────
# Optional. Defaults to the superuser credentials when unset.
PB_TESTUSER_EMAIL=user@example.com
PB_TESTUSER_PASSWORD=changeme123

# ── Dev ────────────────────────────────────────────────────────────────
# DEV=true is legacy (vite plugin owns dev now); kept for compatibility.
DEV=true
